<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/button_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <ImageView
        android:id="@+id/button_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_disc" />

    <ImageView
        android:id="@+id/button_play"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/playback_play"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pip_play" />
</FrameLayout>
